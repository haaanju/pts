{
  "name": "@pts/web",
  "version": "0.9.5",
  "private": true,
  "type": "module",
  "description": "Web output of @pts/tokens: CSS custom properties, JS/TS and SCSS references to them, and self-hosted fonts",
  "license": "(MIT AND OFL-1.1)",
  "files": [
    "dist",
    "fonts"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tokens.js": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.scss": "./dist/tokens.scss",
    "./fonts.css": "./fonts/fonts.css"
  },
  "scripts": {
    "build": "tz build",
    "pretest": "npm run build --silent",
    "test": "node --test test/output.test.ts",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@pts/tokens": "*"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/parser": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/plugin-css-in-js": "^2.7.1",
    "@terrazzo/plugin-sass": "^2.7.1",
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3"
  }
}

{
  "name": "pts",
  "private": true,
  "description": "Plain — DTCG design tokens built with Terrazzo",
  "workspaces": [
    "tokens",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check": "npm run check --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "storybook": "npm run storybook -w @pts/storybook",
    "build-storybook": "npm run build-storybook -w @pts/storybook"
  },
  "engines": {
    "node": ">=22.18"
  }
}

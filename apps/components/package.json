{
  "name": "@pts/components",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Web components built on the @pts/web tokens: <pts-button>, <pts-switch>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./button.js": {
      "types": "./dist/button/button.d.ts",
      "default": "./dist/button/button.js"
    },
    "./switch.js": {
      "types": "./dist/switch/switch.d.ts",
      "default": "./dist/switch/switch.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tz build --quiet && tsc -p tsconfig.build.json && node scripts/summary.ts",
    "test": "node --test test/tokens.test.ts",
    "typecheck": "tsc -p . && tsc -p scripts"
  },
  "dependencies": {
    "@pts/web": "*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@terrazzo/token-tools": "^2.7.1",
    "@types/node": "^22.20.4",
    "typescript": "~5.9.3"
  }
}

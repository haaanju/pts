{
  "name": "@pts/components",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "description": "Web components built on the @pts/web tokens: <pts-button>, <pts-switch>",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "exports": {
    "./button.js": {
      "types": "./dist/button.d.ts",
      "default": "./dist/button.js"
    },
    "./switch.js": {
      "types": "./dist/switch.d.ts",
      "default": "./dist/switch.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/summary.ts",
    "typecheck": "tsc -p . && tsc -p scripts"
  },
  "dependencies": {
    "@pts/web": "*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}

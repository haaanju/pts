{
  // Type-checks the Node scripts, the token test, and the Terrazzo config. They run without a build step (Node's type
  // stripping), so only erasable TypeScript syntax is allowed.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "../test/*.ts", "../terrazzo.config.ts"]
}

{
  "name": "@pts/storybook",
  "version": "0.9.4",
  "private": true,
  "type": "module",
  "description": "Token documentation (Storybook)",
  "license": "MIT",
  "scripts": {
    "prestorybook": "npm run build -w @pts/web -w @pts/components",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build -w @pts/web -w @pts/components",
    "build-storybook": "storybook build -o dist",
    "typecheck": "tsc -p . && tsc -p scripts",
    "test-a11y": "node scripts/a11y.ts"
  },
  "dependencies": {
    "@pts/components": "*",
    "@pts/tokens": "*",
    "@pts/web": "*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/icons": "^2.1.0",
    "@storybook/react-vite": "^10.6.0",
    "@terrazzo/parser": "^2.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  }
}

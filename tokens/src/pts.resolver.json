{
  "name": "PTS",
  "version": "2025.10",
  "description": "Base tokens plus a theme modifier (light | dark), a density modifier (relaxed | compact), and a viewport modifier (narrow | wide).",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "primitive/dimension.tokens.json"
        },
        {
          "$ref": "primitive/typography.tokens.json"
        },
        {
          "$ref": "primitive/color.tokens.json"
        },
        {
          "$ref": "primitive/motion.tokens.json"
        },
        {
          "$ref": "semantic/spacing.tokens.json"
        },
        {
          "$ref": "semantic/border.tokens.json"
        },
        {
          "$ref": "semantic/typography.tokens.json"
        },
        {
          "$ref": "semantic/size.tokens.json"
        },
        {
          "$ref": "semantic/breakpoint.tokens.json"
        },
        {
          "$ref": "semantic/motion.tokens.json"
        },
        {
          "$ref": "semantic/z-index.tokens.json"
        },
        {
          "$ref": "semantic/color.tokens.json"
        },
        {
          "$ref": "component/button.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "contexts": {
        "light": [
          {
            "$ref": "semantic/color.light.tokens.json"
          },
          {
            "$ref": "semantic/shadow.light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "semantic/color.dark.tokens.json"
          },
          {
            "$ref": "semantic/shadow.dark.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "density": {
      "contexts": {
        "relaxed": [
          {
            "$ref": "semantic/spacing.relaxed.tokens.json"
          },
          {
            "$ref": "semantic/size.relaxed.tokens.json"
          }
        ],
        "compact": [
          {
            "$ref": "semantic/spacing.compact.tokens.json"
          },
          {
            "$ref": "semantic/size.compact.tokens.json"
          }
        ]
      },
      "default": "relaxed"
    },
    "viewport": {
      "contexts": {
        "narrow": [
          {
            "$ref": "semantic/typography.narrow.tokens.json"
          }
        ],
        "wide": [
          {
            "$ref": "semantic/typography.wide.tokens.json"
          }
        ]
      },
      "default": "narrow"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/density"
    },
    {
      "$ref": "#/modifiers/viewport"
    }
  ]
}

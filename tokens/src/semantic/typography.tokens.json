{
  "font-family": {
    "sans": {
      "$type": "fontFamily",
      "$value": "{typeface.aspekta}",
      "$description": "Default typeface (Aspekta) for all UI text."
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "{typeface.ibm-plex-serif}",
      "$description": "Serif typeface (IBM Plex Serif) for long-form and editorial text."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "{typeface.ibm-plex-mono}",
      "$description": "Monospace typeface (IBM Plex Mono) for code, and wherever digits must line up: Aspekta has no tabular figures."
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": "{weight.400}",
      "$description": "Body text and captions."
    },
    "medium": {
      "$type": "fontWeight",
      "$value": "{weight.500}",
      "$description": "Labels and other short UI text that needs more weight than body text."
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": "{weight.600}",
      "$description": "Emphasis inside body text, and controls that need more weight than medium. No text style uses it."
    },
    "bold": {
      "$type": "fontWeight",
      "$value": "{weight.700}",
      "$description": "Display text and every heading."
    }
  },
  "font-size": {
    "text": {
      "xs": {
        "$type": "dimension",
        "$value": "{dimension.12}",
        "$description": "The smallest text size: captions and small labels (text/label-sm, text/caption). 12px."
      },
      "sm": {
        "$type": "dimension",
        "$value": "{dimension.14}",
        "$description": "Small body text, small control labels, and code (text/body-sm, text/label-md, text/code-md). 14px."
      },
      "md": {
        "$type": "dimension",
        "$value": "{dimension.16}",
        "$description": "The default body size and control labels (text/body-md, text/label-lg). 16px."
      },
      "lg": {
        "$type": "dimension",
        "$value": "{dimension.20}",
        "$description": "Lead paragraphs and small headings; heading-sm and body-lg share it, told apart by weight (text/heading-sm, text/body-lg). 20px."
      }
    }
  },
  "line-height": {
    "text": {
      "xs": {
        "$type": "number",
        "$value": 1.3333333333333333,
        "$description": "Pairs with font-size/text/xs: a 16px line on 12px text."
      },
      "sm": {
        "$type": "number",
        "$value": 1.4285714285714286,
        "$description": "Pairs with font-size/text/sm: a 20px line on 14px text."
      },
      "md": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Pairs with font-size/text/md: a 24px line on 16px text."
      },
      "lg": {
        "$type": "number",
        "$value": 1.4,
        "$description": "Pairs with font-size/text/lg: a 28px line on 20px text."
      }
    }
  },
  "letter-spacing": {
    "normal": {
      "$type": "dimension",
      "$value": "{tracking.0}",
      "$description": "Every text size (font-size/text/*): Aspekta's default spacing already suits it."
    },
    "wide": {
      "$type": "dimension",
      "$value": "{tracking.100}",
      "$description": "Uppercase labels, which need more space between letters to stay readable."
    }
  },
  "text": {
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.display.xl}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.display.xl}",
        "lineHeight": "{line-height.display.xl}"
      },
      "$description": "The largest display style, for hero headlines."
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.display.lg}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.display.lg}",
        "lineHeight": "{line-height.display.lg}"
      },
      "$description": "Display style for page-level headlines."
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.display.md}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.display.md}",
        "lineHeight": "{line-height.display.md}"
      },
      "$description": "Page titles."
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.display.sm}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.display.sm}",
        "lineHeight": "{line-height.display.sm}"
      },
      "$description": "Section headings."
    },
    "heading-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.lg}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.lg}"
      },
      "$description": "Subsection headings and card titles. The same size as body-lg, set apart by weight, so the two pair as title and subtitle."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.lg}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.lg}"
      },
      "$description": "Lead paragraphs, introductory text, and subtitles under heading-sm."
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.md}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.md}"
      },
      "$description": "Default body text."
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.sm}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.sm}"
      },
      "$description": "Secondary body text: supporting descriptions, table cells, and dense UI."
    },
    "label-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.md}",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.md}"
      },
      "$description": "Labels on default (md) and large controls, such as md and lg buttons."
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.sm}",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.sm}"
      },
      "$description": "Labels on small controls, such as sm buttons, and on tabs and menu items."
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.xs}",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.xs}"
      },
      "$description": "Labels on badges, tags, and other elements smaller than a control."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.text.xs}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.xs}"
      },
      "$description": "Helper text, timestamps, and footnotes."
    },
    "code-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.mono}",
        "fontSize": "{font-size.text.sm}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.text.sm}"
      },
      "$description": "Inline code and code blocks."
    }
  }
}

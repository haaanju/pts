{
  "font-family": {
    "sans": {
      "$type": "fontFamily",
      "$value": "{typeface.aspekta}",
      "$description": "Default typeface (Aspekta) for all UI text."
    },
    "serif": {
      "$type": "fontFamily",
      "$value": "{typeface.ibm-plex-serif}",
      "$description": "Serif typeface (IBM Plex Serif) for long-form and editorial text."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": "{typeface.ibm-plex-mono}",
      "$description": "Monospace typeface (IBM Plex Mono) for code, and wherever digits must line up: Aspekta has no tabular figures."
    }
  },
  "font-weight": {
    "regular": {
      "$type": "fontWeight",
      "$value": "{weight.400}",
      "$description": "Body text and captions."
    },
    "medium": {
      "$type": "fontWeight",
      "$value": "{weight.500}",
      "$description": "Labels and other short UI text that needs more weight than body text."
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": "{weight.600}",
      "$description": "Small and medium headings, and emphasis inside body text."
    },
    "bold": {
      "$type": "fontWeight",
      "$value": "{weight.700}",
      "$description": "Display text and large headings."
    }
  },
  "font-size": {
    "200": {
      "$type": "dimension",
      "$value": "{dimension.12}",
      "$description": "Captions and small labels (text/caption, text/label-sm). The smallest size for text."
    },
    "300": {
      "$type": "dimension",
      "$value": "{dimension.14}",
      "$description": "Small body text, labels, and code (text/body-sm, text/label-md, text/code-md)."
    },
    "400": {
      "$type": "dimension",
      "$value": "{dimension.16}",
      "$description": "Default body size (text/body-md)."
    },
    "500": {
      "$type": "dimension",
      "$value": "{dimension.18}",
      "$description": "Large body text (text/body-lg)."
    },
    "600": {
      "$type": "dimension",
      "$value": "{dimension.20}",
      "$description": "Small headings (text/heading-sm)."
    },
    "700": {
      "$type": "dimension",
      "$value": "{dimension.24}",
      "$description": "Medium headings (text/heading-md)."
    },
    "800": {
      "$type": "dimension",
      "$value": "{dimension.32}",
      "$description": "Large headings (text/heading-lg)."
    },
    "900": {
      "$type": "dimension",
      "$value": "{dimension.40}",
      "$description": "Display text (text/display-md)."
    },
    "1000": {
      "$type": "dimension",
      "$value": "{dimension.48}",
      "$description": "The largest display text (text/display-lg)."
    }
  },
  "line-height": {
    "tight": {
      "$type": "number",
      "$value": "{ratio.120}",
      "$description": "Headings, display text, and single-line labels."
    },
    "normal": {
      "$type": "number",
      "$value": "{ratio.150}",
      "$description": "Default for body text."
    },
    "loose": {
      "$type": "number",
      "$value": "{ratio.175}",
      "$description": "Long-form reading text, where extra leading helps."
    }
  },
  "letter-spacing": {
    "tighter": {
      "$type": "dimension",
      "$value": "{tracking.neg-100}",
      "$description": "Display text: large sizes look loose at normal tracking."
    },
    "tight": {
      "$type": "dimension",
      "$value": "{tracking.neg-50}",
      "$description": "Large and medium headings."
    },
    "normal": {
      "$type": "dimension",
      "$value": "{tracking.0}",
      "$description": "All other text."
    },
    "wide": {
      "$type": "dimension",
      "$value": "{tracking.100}",
      "$description": "Uppercase labels, which need more space between letters to stay readable."
    }
  },
  "text": {
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.1000}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.tighter}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "The largest display style, for hero headlines."
    },
    "display-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.900}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.tighter}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Display style for page-level headlines."
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.800}",
        "fontWeight": "{font-weight.bold}",
        "letterSpacing": "{letter-spacing.tight}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Page titles."
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.700}",
        "fontWeight": "{font-weight.semibold}",
        "letterSpacing": "{letter-spacing.tight}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Section headings."
    },
    "heading-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.600}",
        "fontWeight": "{font-weight.semibold}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Subsection headings and card titles."
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.500}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.normal}"
      },
      "$description": "Lead paragraphs and introductory text."
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.400}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.normal}"
      },
      "$description": "Default body text."
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.300}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.normal}"
      },
      "$description": "Secondary body text: supporting descriptions, table cells, and dense UI."
    },
    "label-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.300}",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Labels on controls: buttons, inputs, tabs, and menu items."
    },
    "label-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.200}",
        "fontWeight": "{font-weight.medium}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.tight}"
      },
      "$description": "Labels on small controls, badges, and tags."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.sans}",
        "fontSize": "{font-size.200}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.normal}"
      },
      "$description": "Helper text, timestamps, and footnotes."
    },
    "code-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font-family.mono}",
        "fontSize": "{font-size.300}",
        "fontWeight": "{font-weight.regular}",
        "letterSpacing": "{letter-spacing.normal}",
        "lineHeight": "{line-height.normal}"
      },
      "$description": "Inline code and code blocks."
    }
  }
}
